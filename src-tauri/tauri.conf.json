{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri/refs/heads/dev/crates/tauri-utils/schema.json",
  "productName": "DevEco Switch",
  "version": "2.0.0",
  "identifier": "com.deveco-switch.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "features": ["embedding", "custom-protocol"]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DevEco Switch",
        "width": 1100,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    },
    "resources": {
      "runtime/node": "node",
      "runtime/git": "git",
      "runtime/jdk": "jdk",
      "resources/seed": "seed",
      "resources/embedding": "embedding"
    }
  },
  "plugins": {
    "shell": {
      "open": "(https?://|mailto:|tel:|[a-zA-Z]:[\\\\/]|/|\\\\).*"
    },
    "updater": {
      "endpoints": [
        "https://github.com/lookapu/HarmonyAgent/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE4REFDMTU0MTQ0NkJBNkUKUldSdXVrWVVWTUhhR0NNRVZKVEJLVTNzdDF0dHQ4ZHVTMnNKUWFxZkxlMEo0VFZybWhVNFlHLzQK"
    }
  }
}
